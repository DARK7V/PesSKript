import os

def banner():
    print("\n" + "="*40)
    print("\033[91m🔥 Tool by DARK KING 🔥\033[0m".center(40))
    print("="*40 + "\n")

def generate_patch(offsets, patch_type, lib_name, hex_code):
    lines = []
    # حقوق داخل الملف (كتعليق)
    lines.append("// 🔥 Script Generated by DARK KING 🔥\n")
    for off in offsets:
        if patch_type == "1":  # PATCH_LIB
            lines.append(f'PATCH_LIB("{lib_name}", {off}, "{hex_code}");')
        elif patch_type == "2":  # MemoryPatch
            lines.append(f'MemoryPatch::createWithHex("{lib_name}", {off}, "{hex_code}").Modify();')
    return "\n".join(lines)

def main():
    banner()

    print("🔹 اختر نوع التوليد:\n1 - PATCH_LIB\n2 - MemoryPatch")
    patch_type = input("> ").strip()

    print("\n🔹 اختر نوع الـ Hex:")
    hex_options = {
        "1": ("00 20 70 47", "تعطيل الدالة (إرجاع مباشر)"),
        "2": ("01 20 70 47", "إرجاع دائم للقيمة 1 (True)"),
        "3": ("00 F0 20 E3", "NOP - تعطيل التعليمات"),
        "4": ("C0 46", "NOP قصير - تعطيل نقطة صغيرة"),
        "5": ("FF 20 70 47", "إرجاع القيمة القصوى (255)")
    }

    for key, (code, desc) in hex_options.items():
        print(f"{key} - {code} → {desc}")

    hex_choice = input("> ").strip()
    hex_code = hex_options.get(hex_choice, ("00 20 70 47", ""))[0]

    offsets = []
    lib_name = None

    print("\n🔹 الصق الأوفستات (lib offset) كل سطر لوحده.")
    print("🔹 لو كتبت أوفست بس → هيطلب منك اسم lib.")
    print("🔹 لما تخلص اكتب كلمة 'تم'\n")

    while True:
        line = input("> ").strip()
        if line.lower() == "تم":
            break
        parts = line.split()
        if len(parts) == 2:
            lib_name, offset = parts
            offsets.append(offset)
        elif len(parts) == 1:
            offset = parts[0]
            if offset.startswith("0x"):
                offsets.append(offset)
            else:
                print("⚠️ إدخال غير صحيح، لازم يكون أوفست بصيغة 0x...")
        else:
            print("⚠️ تجاهلت السطر (مش مفهوم).")

    if not lib_name:
        lib_name = input("⚠️ لم يتم تحديد lib، اكتب اسمه (مثال: libanogs.so): ").strip()

    # ملخص نهائي
    print("\n📄 الملخص النهائي:")
    print(f"🔹 نوع التوليد: {'PATCH_LIB' if patch_type == '1' else 'MemoryPatch'}")
    print(f"🔹 اسم المكتبة: {lib_name}")
    print(f"🔹 عدد الأوفستات: {len(offsets)}")
    print(f"🔹 الكود المختار: {hex_code}")
    save_path = "/sdcard/patch_code.txt"
    print(f"📂 مسار الحفظ: {save_path}")

    # إنشاء الكود وحفظه
    code = generate_patch(offsets, patch_type, lib_name, hex_code)
    os.makedirs(os.path.dirname(save_path), exist_ok=True)
    with open(save_path, "w") as f:
        f.write(code)

    print(f"\n✅ تم الحفظ تلقائيًا في: {save_path}")
    print("\033[91m🔥 : DARK KING 🔥\033[0m".center(40))

if __name__ == "__main__":
    main()
