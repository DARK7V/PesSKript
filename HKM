import os

def generate_patch(offsets, patch_type, lib_name):
    lines = []
    for off in offsets:
        if patch_type == "1":  # PATCH_LIB
            lines.append(f'PATCH_LIB("{lib_name}", {off}, "00 20 70 47");')
        elif patch_type == "2":  # MemoryPatch
            lines.append(f'MemoryPatch::createWithHex("{lib_name}", {off}, "00 20 70 47").Modify();')
    return "\n".join(lines)

def main():
    print("🔹 اختر نوع التوليد:\n1 - PATCH_LIB\n2 - MemoryPatch")
    patch_type = input("> ").strip()

    offsets = []
    lib_name = None

    print("\n🔹 الصق الأوفستات (lib offset) كل سطر لوحده.")
    print("🔹 لو كتبت أوفست بس → هيطلب منك اسم lib.")
    print("🔹 لما تخلص اكتب كلمة 'تم'\n")

    while True:
        line = input("> ").strip()
        if line.lower() == "تم":
            break
        parts = line.split()
        if len(parts) == 2:
            lib_name, offset = parts
            offsets.append(offset)
        elif len(parts) == 1:
            offset = parts[0]
            if offset.startswith("0x"):
                offsets.append(offset)
            else:
                print("⚠️ إدخال غير صحيح، لازم يكون أوفست بصيغة 0x...")
        else:
            print("⚠️ تجاهلت السطر (مش مفهوم).")

    # التحقق من الليب بعد ما المستخدم يكتب "تم"
    if not lib_name:
        lib_name = input("⚠️ لم يتم تحديد lib، اكتب اسمه (مثال: libanogs.so): ").strip()

    # ملخص نهائي
    print("\n📄 الملخص النهائي:")
    print(f"🔹 نوع التوليد: {'PATCH_LIB' if patch_type == '1' else 'MemoryPatch'}")
    print(f"🔹 اسم المكتبة: {lib_name}")
    print(f"🔹 عدد الأوفستات: {len(offsets)}")
    save_path = "/sdcard/patch_code.txt"
    print(f"📂 مسار الحفظ: {save_path}")

    confirm = input("\nهل تريد المتابعة والحفظ؟ (y/n): ").strip().lower()
    if confirm != "y":
        print("❌ تم الإلغاء.")
        return

    # إنشاء الكود وحفظه
    code = generate_patch(offsets, patch_type, lib_name)
    os.makedirs(os.path.dirname(save_path), exist_ok=True)
    with open(save_path, "w") as f:
        f.write(code)

    print(f"\n✅ تم الحفظ تلقائيًا في: {save_path}")

if __name__ == "__main__":
    main()
