import os
import re
from collections import defaultdict

def banner():
    print("\n" + "="*40)
    print("\033[91m🔥 Tool by DARK KING 🔥\033[0m".center(40))
    print("="*40 + "\n")

KEY = 0xAA  # مفتاح XOR ثابت

def encrypt_offset(offset):
    """تشفير الأوفست بواسطة XOR."""
    try:
        value = int(offset, 16)
        encrypted = value ^ KEY
        return f"0x{encrypted:X}"
    except:
        return offset

def parse_patch_line(line):
    """محاولة التعرف على المكتبة + الأوفست + hex من أي صيغة."""
    # صيغة PATCH_LIB أو MemoryPatch
    pattern = r'\("([^"]+)",\s*(0x[0-9A-Fa-f]+),\s*"([^"]*)"\)'
    match = re.search(pattern, line)
    if match:
        lib, offset, hex_code = match.groups()
        return lib.strip(), offset.strip(), hex_code.strip()

    # صيغة عادية: lib offset
    pattern2 = r'([^\s]+)\s+(0x[0-9A-Fa-f]+)'
    match2 = re.search(pattern2, line)
    if match2:
        lib, offset = match2.groups()
        return lib.strip(), offset.strip(), ""
    
    return None, None, None

def generate_patch(offsets, patch_type, hex_override=""):
    lines = []
    lines.append("// 🔥 Script Generated by DARK KING 🔥\n")
    for lib, off, original_hex in offsets:
        final_hex = hex_override if hex_override else (original_hex if original_hex else "00 20 70 47")
        if patch_type == "1":
            lines.append(f'PATCH_LIB("{lib}", {off}, "{final_hex}");')
        elif patch_type == "2":
            lines.append(f'MemoryPatch::createWithHex("{lib}", {off}, "{final_hex}").Modify();')
        elif patch_type == "3":
            enc_off = encrypt_offset(off)
            lines.append(f'ENCRYPTED_PATCH("{lib}", {enc_off}, "{final_hex}");')
    return "\n".join(lines)

def stats_report(offsets, patch_type, hex_used):
    """يولد تقرير بالإحصائيات"""
    stats = defaultdict(int)
    for lib, _, _ in offsets:
        stats[lib] += 1

    # ترجمة نوع الباتش
    patch_types = {"1": "PATCH_LIB", "2": "MemoryPatch", "3": "Encrypted Offsets"}
    patch_name = patch_types.get(patch_type, "غير معروف")

    report = "\n📊 الإحصائيات:\n"
    for lib, count in stats.items():
        report += f"- المكتبة {lib} → {count} أوفست\n"
    report += f"\n🔹 نوع الباتش المستخدم: {patch_name}\n"
    report += f"🔹 الـ Hex المستخدم: {hex_used if hex_used else 'متنوع / أصلي'}\n"
    report += f"\nإجمالي الأوفستات: {len(offsets)}\n"
    report += f"إجمالي المكتبات: {len(stats)}\n"
    return report

def main():
    banner()
    print("🔹 اختر العملية:")
    print("1 - توليد باتش جديد")
    print("2 - تحويل باتش موجود")
    choice = input("> ").strip()

    offsets = []
    hex_override = ""
    patch_type = ""

    if choice == "1":
        print("🔹 اختر نوع التوليد:\n1 - PATCH_LIB\n2 - MemoryPatch\n3 - Encrypted Offsets")
        patch_type = input("> ").strip()

        print("\n🔹 اختر نوع الـ Hex:")
        hex_options = {
            "1": ("00 20 70 47", "تعطيل الدالة (إرجاع مباشر)"),
            "2": ("01 20 70 47", "إرجاع دائم للقيمة 1 (True)"),
            "3": ("00 F0 20 E3", "NOP - تعطيل التعليمات"),
            "4": ("C0 46", "NOP قصير - تعطيل نقطة صغيرة"),
            "5": ("FF 20 70 47", "إرجاع القيمة القصوى (255)")
        }
        for key, (code, desc) in hex_options.items():
            print(f"{key} - {code} → {desc}")
        hex_choice = input("> ").strip()
        hex_override = hex_options.get(hex_choice, ("", ""))[0]

        print("\n🔹 الصق الأوفستات (lib offset) كل سطر لوحده. لما تخلص اكتب 'تم'")
        while True:
            line = input("> ").strip()
            if line.lower() == "تم":
                break
            lib, offset, hex_code = parse_patch_line(line)
            if offset:
                offsets.append((lib, offset, hex_code))
        if not offsets:
            print("❌ لم يتم إدخال أي أوفست.")
            return

    elif choice == "2":
        print("🔹 الصق الباتش الأصلي (سطر بسطر). لما تخلص اكتب 'تم'")
        while True:
            line = input("> ").strip()
            if line.lower() == "تم":
                break
            lib, offset, hex_code = parse_patch_line(line)
            if offset:
                offsets.append((lib, offset, hex_code))
        if not offsets:
            print("❌ لم يتم إدخال أي باتش.")
            return

        print("🔹 اختر نوع الباتش النهائي للتحويل:")
        print("1 - PATCH_LIB\n2 - MemoryPatch\n3 - Encrypted Offsets")
        patch_type = input("> ").strip()

        keep_hex = input("🔹 هل تريد ترك Hex كما هو في الباتش الأصلي؟ (y/n): ").strip().lower()
        if keep_hex != "y":
            hex_override = input("🔹 اكتب Hex جديد لكل الباتش: ").strip()

    else:
        print("❌ اختيار غير صالح.")
        return

    save_path = "/sdcard/patch_code.txt"
    code = generate_patch(offsets, patch_type, hex_override)
    os.makedirs(os.path.dirname(save_path), exist_ok=True)
    with open(save_path, "w") as f:
        f.write(code + "\n\n" + stats_report(offsets, patch_type, hex_override))

    print(f"\n✅ تم الحفظ تلقائيًا في: {save_path}")
    print(stats_report(offsets, patch_type, hex_override))
    print("\033[91m🔥 : DARK KING 🔥\033[0m".center(40))

if __name__ == "__main__":
    main()
